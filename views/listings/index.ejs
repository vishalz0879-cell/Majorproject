<% layout("/layouts/boilerplate") %>
<body>
    <h1>All listings</h1>
    <form method="GET" action="/listings/new">
        <button>Create New Listing</button>
        </form>
    <ul>
        
  <%for(let listings of allListings){%>
    <li><a href="/listings/<%= listings._id%>"><%= listings.title %></a></li>
    
    <%}%>
</ul>
</body>
