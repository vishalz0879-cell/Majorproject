<% layout("/layouts/boilerplate") %>
<body>
    <h1>All listings</h1>
    <div class="row row-cols-lg-3 row-col-md-2 row-col-sm-1">
      <%for(let listings of allListings){%>
        <a href="/listings/<%= listings._id %>" class="listing-link">
      <div class="card " >
         <img src="<%= listings.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
         <div class="card-img-overlay"></div>
         <div class="card text-bg-dark">
 
</div>
        <div class="card-body">
           <p class="card-text">
            <b> <%= listings.title %></b> <br>
            &#8377;<%= (listings.price || 0).toLocaleString("en-IN") %>/night
           </p>
        </div>
      </div>
      </a>
    <%}%>
    </div>
    
</body>
